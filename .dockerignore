# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include the UI's own source tree: Dockerfile.ichor-ui's ui-builder stage needs it
# to run "npm run build" (Vite writes straight into cmd/ichor-ui/dist). node_modules and
# dist are excluded again so the image always installs/builds fresh rather than copying
# whatever happens to exist on the host.
!ui/**
ui/node_modules
ui/dist

# The installer image embeds this tree's install manifest; make docker-build-installer writes it.
!internal/installmanifest/install.yaml

!pkg/cni/cilium/chart/*.tgz
!internal/imagesig/trusted_root.json
