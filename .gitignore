.internal/
.claude/settings.local.json
result

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# Kubeconfig might contain secrets
*.kubeconfig

# Generated release artifacts (make build-installer writes dist/install.yaml).
# dist/chart is also generated (kubebuilder edit --plugins=helm/v2-alpha from
# dist/install.yaml) but is a committed distributable, so it is not ignored.
dist/install.yaml
dist/network-policies.yaml

# UI (ADR 0017): npm dependencies and the Vite build. The build lands in
# cmd/ichor-ui/dist, which `go:embed` picks up with -tags uiembed; it is
# never committed, same as any other build output.
ui/node_modules/
cmd/ichor-ui/dist/

# `make build-ichor-embed`'s copy of dist/install.yaml, embedded with
# -tags installembed (ADR 0019); never committed, same reasoning as
# dist/install.yaml itself above.
internal/installmanifest/install.yaml
internal/installmanifest/network-policies.yaml

# goreleaser's own output directory (.goreleaser.yaml sets dist: to this,
# instead of the default "dist/", so that "goreleaser build --clean" never
# wipes the committed dist/chart above).
.goreleaser-dist/

# Screenshots from `make ui-shots`.
.ui-shots/

# Binaries that `go build ./cmd/...` drops in the repo root.
/ichor
/ichor-ui
/manager
gate.done
