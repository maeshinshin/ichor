# Build the UI (Vite writes straight into cmd/ichor-ui/dist, matching "make ui-build")
FROM node:24 AS ui-builder
WORKDIR /workspace
COPY . .
RUN cd ui && npm ci && npm run build

# Build the ichor-ui binary with the real UI embedded, not the placeholder
# (-tags uiembed, docs/adr/0017)
FROM golang:1.27.3 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN go mod download

# Copy the Go source (relies on .dockerignore to filter)
COPY . .
COPY --from=ui-builder /workspace/cmd/ichor-ui/dist cmd/ichor-ui/dist

# Build
# the GOARCH has no default value to allow the binary to be built according to the host where the command
# was called. For example, if we call make docker-build-ichor-ui in a local env which has the Apple Silicon M1 SO
# the docker BUILDPLATFORM arg will be linux/arm64 when for Apple x86 it will be linux/amd64. Therefore,
# by leaving it empty we can ensure that the container and binary shipped on it will have the same platform.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -tags uiembed -a -o ichor-ui ./cmd/ichor-ui

# Use distroless as minimal base image to package the ichor-ui binary
# Refer to https://github.com/GoogleContainerTools/distroless for more details
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/ichor-ui .
USER 65532:65532

ENTRYPOINT ["/ichor-ui"]
