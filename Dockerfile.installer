# The installer Job's image (docs/adr/0058): the ichor binary with this version's install
# manifest embedded (-tags installembed), run as `ichor installer run`. The manifest comes
# from the build context -- `make docker-build-installer` writes it to
# internal/installmanifest/install.yaml first -- so the image carries exactly the manifest
# the same tree generated, and fetches nothing when it runs.
FROM golang:1.27.3@sha256:2920bb124f1a2e12a1d39f0cab756ae0068441ee1da7655dec7f5e374944095b AS builder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY . .

RUN test -f internal/installmanifest/network-policies.yaml || { echo "run make docker-build-installer: network-policies.yaml is not in the build context" >&2; exit 1; }
RUN test -f internal/installmanifest/install.yaml || { echo "run make docker-build-installer: install.yaml is not in the build context" >&2; exit 1; }
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -tags installembed -a -trimpath \
    -ldflags "-s -w -X github.com/maeshinshin/ichor/internal/version.Version=${VERSION}" -o ichor ./cmd/ichor

FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
WORKDIR /
COPY --from=builder /workspace/ichor .
USER 65532:65532

ENTRYPOINT ["/ichor"]
