          <mxCell id="m2" parent="1" style="rounded=1;arcSize=12;fillColor=light-dark(#FFFBEB,#2B2008);strokeColor=light-dark(#D97706,#FBBF24);strokeWidth=1.5;fontColor=light-dark(#78350F,#FDE68A);fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;html=0;" value="2. It waits as a&#xa;pending machine until&#xa;you approve it" vertex="1"><mxGeometry x="200" y="40" width="160" height="90" as="geometry" /></mxCell>
          <mxCell id="m3" parent="1" style="rounded=1;arcSize=12;fillColor=light-dark(#EEF2FF,#232553);strokeColor=light-dark(#6366F1,#818CF8);strokeWidth=1.5;fontColor=light-dark(#1E1B4B,#E0E7FF);fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;html=0;" value="3. You approve it:&#xa;ichor approve node&#xa;NAME --role worker" vertex="1"><mxGeometry x="380" y="40" width="160" height="90" as="geometry" /></mxCell>
          <mxCell id="m4" parent="1" style="rounded=1;arcSize=12;fillColor=light-dark(#EEF2FF,#232553);strokeColor=light-dark(#6366F1,#818CF8);strokeWidth=1.5;fontColor=light-dark(#1E1B4B,#E0E7FF);fontFamily=Helvetica;fontSize=13;align=center;verticalAlign=middle;html=0;" value="4. The controller&#xa;applies the config;&#xa;the node installs&#xa;Talos, reboots" vertex="1"><mxGeometry x="560" y="40" width="160" height="90" as="geometry" /></mxCell>
