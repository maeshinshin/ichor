{
  description = "Ichor toolchain";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixpkgs-unstable";

  outputs = { self, nixpkgs }:
    let
      systems = [ "x86_64-linux" "aarch64-linux" ];
      forAllSystems = nixpkgs.lib.genAttrs systems;
    in
    {
      devShells = forAllSystems (system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
        in
        {
          default = pkgs.mkShell {
            packages = with pkgs; [
              go_1_27
              kubebuilder
              kubernetes-controller-tools
              kustomize
              setup-envtest
              cobra-cli
              talosctl
              kubectl
              kubernetes-helm
              buf
              protoc-gen-go
              protoc-gen-connect-go
              goreleaser
              golangci-lint
              govulncheck
              qemu
              cni-plugins
              nodejs
              gnumake
              git
            ];

            # Makefile targets generated by kubebuilder declare these with `?=`,
            # so setting them here means `make generate` etc. use the flake's
            # binaries instead of `go install`-ing their own into ./bin.
            CONTROLLER_GEN = "${pkgs.kubernetes-controller-tools}/bin/controller-gen";
            KUSTOMIZE = "${pkgs.kustomize}/bin/kustomize";
            # shortcut: envtest assets (kube-apiserver, etcd) still downloaded by
            # setup-envtest at test time; nixpkgs doesn't package them. Revisit
            # if an offline/air-gapped CI is needed.
            ENVTEST = "${pkgs.setup-envtest}/bin/setup-envtest";
            GOLANGCI_LINT = "${pkgs.golangci-lint}/bin/golangci-lint";
          };
        });
    };
}
