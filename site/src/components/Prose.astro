---
// The rendered Markdown of a docs page. Callouts (`> [!NOTE]`) are swapped for
// the preactcn Alert and tables get a scroll container; everything else is the
// Markdown pipeline's own HTML.
import { fromHtml } from 'hast-util-from-html'
import { h } from 'preact'
import { renderToString } from 'preact-render-to-string'
import rehypeParse from 'rehype-parse'
import rehypeStringify from 'rehype-stringify'
import { unified } from 'unified'
import { visit } from 'unist-util-visit'
import { Link } from 'lucide-preact'
import { buttonVariants } from '@/components/ui/button'
import { Callout, type CalloutKind } from './Callout'

const html = await Astro.slots.render('default')

function callouts() {
  return (tree: any) => {
    visit(tree, 'element', (node: any, i, parent: any) => {
      const kind = node.properties?.dataCallout as CalloutKind | undefined
      if (kind) {
        const alert = fromHtml(renderToString(h(Callout, { kind }, h('span', { 'data-here': '' }))), { fragment: true })
        visit(alert, 'element', (n: any) => {
          if (n.properties?.dataHere !== undefined) Object.assign(n, { tagName: 'div', properties: {}, children: node.children })
        })
        parent.children[i] = { type: 'element', tagName: 'div', properties: { className: ['not-prose', 'my-4'] }, children: alert.children }
      } else if (node.tagName === 'table') {
        parent.children[i] = { type: 'element', tagName: 'div', properties: { className: ['overflow-x-auto'] }, children: [node] }
        return 'skip'
      }
    })
  }
}

const text = (n: any): string => n.value ?? (n.children ?? []).map(text).join('')

/**
 * Every h2/h3 ends with a link to itself (shown on hover or focus, always on touch screens).
 * It is a plain anchor, so it works without scripts; the PageActions island copies its URL.
 */
function headingLinks() {
  const icon = fromHtml(renderToString(h(Link, {})), { fragment: true }).children
  return (tree: any) => {
    visit(tree, 'element', (node: any) => {
      if ((node.tagName !== 'h2' && node.tagName !== 'h3') || !node.properties?.id) return
      node.properties.className = [...(node.properties.className ?? []), 'group/heading', 'scroll-mt-20']
      node.children.push({
        type: 'element',
        tagName: 'a',
        properties: {
          href: `#${node.properties.id}`,
          dataHeadingLink: '',
          dataPagefindIgnore: '',
          ariaLabel: `Link to "${text(node)}"`,
          className: [...buttonVariants({ variant: 'ghost', size: 'icon-xs' }).split(' '), 'not-prose', 'ml-1', 'align-middle', 'text-muted-foreground', 'opacity-0', 'group-hover/heading:opacity-100', 'focus-visible:opacity-100', '[@media(hover:none)]:opacity-100'],
        },
        children: structuredClone(icon),
      })
    })
  }
}

const out = String(await unified().use(rehypeParse, { fragment: true }).use(callouts).use(headingLinks).use(rehypeStringify).process(html))
---

<div class="prose prose-neutral max-w-none dark:prose-invert prose-code:before:content-none prose-code:after:content-none prose-pre:bg-muted prose-pre:text-foreground prose-img:mx-auto prose-blockquote:font-normal prose-blockquote:not-italic [&_blockquote_p]:before:content-none [&_blockquote_p]:after:content-none [&_td]:min-w-40 [&_td]:break-words" set:html={out} />
