---
import '../styles/global.css'
import { CodeCopy } from '@/components/CodeCopy'
import { PageActions } from '@/components/PageActions'
import { VersionBanner } from '@/components/VersionBanner'
import { DocsShell } from '@/components/DocsShell'
import { type Heading, TocAside, TocCollapsible } from '@/components/Toc'
import { Breadcrumb, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from '@/components/ui/breadcrumb'
import { Button } from '@/components/ui/button'
import { Card, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Separator } from '@/components/ui/separator'
import { absolute, base, buildNav, crumbs, flatten, getDocs, isNext, latestLine, latestPatch, repoUrl, root, version } from '@/lib/docs'
import { ArrowLeft, ArrowRight, SquarePen } from 'lucide-preact'

interface Props {
  title: string
  /** Site URL of this page, as in the sidebar. */
  current: string
  headings?: Heading[]
  editUrl?: string
  description?: string
  /** Site path of this page's Markdown; pages without one have no page actions. */
  mdUrl?: string
}
const { title, current, headings = [], editUrl, description, mdUrl } = Astro.props
const canonical = absolute(current)

const docs = await getDocs()
const nav = buildNav(docs)
const trail = crumbs(nav, current)
const pages = flatten(nav)
const at = pages.findIndex((p) => p.href === current)
const prev = at > 0 ? pages[at - 1] : undefined
const next = at >= 0 ? pages[at + 1] : undefined
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {mdUrl && <link rel="alternate" type="text/markdown" href={mdUrl} />}
    <title>{current === base ? 'Ichor documentation' : `${title} - Ichor`}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      // First paint in the saved or system theme (same rule as the toggle in DocsShell).
      try {
        var s = localStorage.getItem('ichor-docs-theme')
        var d = s ? s === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
        document.documentElement.classList.toggle('dark', d)
      } catch (e) {}
      // Desktop sidebar state before first paint (same key as DocsShell).
      try {
        document.documentElement.dataset.sidebar = localStorage.getItem('ichor-docs-sidebar') === 'closed' ? 'closed' : 'open'
      } catch (e) {}
    </script>
  </head>
  <body>
    <DocsShell client:load nav={nav} current={current} base={base} root={root} version={version} repoUrl={repoUrl}>
      <div class="mx-auto grid w-full max-w-6xl gap-10 p-4 md:p-8 xl:grid-cols-[minmax(0,1fr)_14rem]">
        <article class="flex min-w-0 flex-col gap-6" data-pagefind-body>
          <div class="hidden has-[[role=alert]]:block" data-pagefind-ignore><VersionBanner client:load version={version} root={root} line={latestLine} patch={latestPatch} /></div>
          <Breadcrumb data-pagefind-ignore>
            <BreadcrumbList>
              <BreadcrumbItem><BreadcrumbLink href={base}>Docs</BreadcrumbLink></BreadcrumbItem>
              {trail.slice(0, -1).filter((c) => c.label && c.href !== base).map((c) => (
                <>
                  <BreadcrumbSeparator />
                  <BreadcrumbItem>{c.href ? <BreadcrumbLink href={c.href}>{c.label}</BreadcrumbLink> : c.label}</BreadcrumbItem>
                </>
              ))}
              {current !== base && (
                <>
                  <BreadcrumbSeparator />
                  <BreadcrumbItem><BreadcrumbPage>{title}</BreadcrumbPage></BreadcrumbItem>
                </>
              )}
            </BreadcrumbList>
          </Breadcrumb>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <h1 class="text-3xl font-semibold tracking-tight" data-pagefind-weight="10">{title}</h1>
            {mdUrl && <div class="shrink-0" data-pagefind-ignore><PageActions client:load title={title} url={canonical} mdUrl={mdUrl} /></div>}
          </div>
          {toc.length > 0 && <div data-pagefind-ignore><TocCollapsible client:idle headings={toc} /></div>}
          <slot />
          <CodeCopy client:idle />
          <Separator />
          <div class="flex flex-col gap-4" data-pagefind-ignore>
            {editUrl && (
              <div>
                <Button asChild variant="ghost" size="sm">
                  <a href={editUrl}><SquarePen />{isNext ? 'Edit this page on GitHub' : `View this page's source on GitHub (${version})`}</a>
                </Button>
              </div>
            )}
            <div class="grid gap-4 sm:grid-cols-2">
              {prev ? (
                <a href={prev.href}>
                  <Card size="sm">
                    <CardHeader>
                      <CardDescription className="flex items-center gap-1"><ArrowLeft className="size-3" />Previous</CardDescription>
                      <CardTitle className="truncate">{prev.label}</CardTitle>
                    </CardHeader>
                  </Card>
                </a>
              ) : <div />}
              {next && (
                <a href={next.href}>
                  <Card size="sm">
                    <CardHeader className="sm:text-right">
                      <CardDescription className="flex items-center gap-1 sm:justify-end">Next<ArrowRight className="size-3" /></CardDescription>
                      <CardTitle className="truncate">{next.label}</CardTitle>
                    </CardHeader>
                  </Card>
                </a>
              )}
            </div>
          </div>
        </article>
        <aside>{toc.length > 0 && <TocAside client:idle headings={toc} />}</aside>
      </div>
      <footer class="mx-auto w-full max-w-6xl border-t p-4 text-sm text-muted-foreground md:px-8" data-pagefind-ignore>
        Ichor is licensed under the Apache License 2.0. The generated CRD reference pages contain content derived from Talos (Sidero Labs, Inc.), which is licensed under the Mozilla Public License 2.0; the source of those pages is at <a class="underline" href={repoUrl}>{repoUrl.replace('https://', '')}</a>, at the Git tag that matches this version of the docs (main, for next). <a class="underline" href={`${root}NOTICE.txt`}>NOTICE</a>, <a class="underline" href={`${root}LICENSE.txt`}>LICENSE</a>, <a class="underline" href={`${root}THIRD-PARTY-NOTICES.txt`}>THIRD-PARTY-NOTICES</a>.
      </footer>
    </DocsShell>
  </body>
</html>
